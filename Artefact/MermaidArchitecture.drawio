        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% ==================================================\n    %% SOURCE LAYER\n    %% ==================================================\n\n    subgraph Sources[\&quot;Clinical Source Exports\&quot;]\n        ONC[\&quot;Oncology Intake CSV\&quot;]\n        REF[\&quot;RT Referral CSV\&quot;]\n        BOOK[\&quot;RT Booking CSV\&quot;]\n        ECAD[\&quot;RT ECAD CSV\&quot;]\n        CT[\&quot;RT CT CSV\&quot;]\n        TRT[\&quot;RT Treatment CSV\&quot;]\n        MACH[\&quot;Machine Appointments CSV\&quot;]\n    end\n\n    %% ==================================================\n    %% ETL LAYER\n    %% ==================================================\n\n    subgraph ETL[\&quot;Python ETL Layer\&quot;]\n        LOAD1[\&quot;load_oncology.py\&quot;]\n        LOAD2[\&quot;load_rt_referral.py\&quot;]\n        LOAD3[\&quot;load_booking.py\&quot;]\n        LOAD4[\&quot;load_ecad.py\&quot;]\n        LOAD5[\&quot;load_ct.py\&quot;]\n        LOAD6[\&quot;load_treat.py\&quot;]\n        LOAD7[\&quot;load_machine_appointments.py\&quot;]\n    end\n\n    ONC --&gt; LOAD1\n    REF --&gt; LOAD2\n    BOOK --&gt; LOAD3\n    ECAD --&gt; LOAD4\n    CT --&gt; LOAD5\n    TRT --&gt; LOAD6\n    MACH --&gt; LOAD7\n\n    %% ==================================================\n    %% STAGING\n    %% ==================================================\n\n    subgraph Staging[\&quot;PostgreSQL Staging Schema\&quot;]\n        STG1[\&quot;staging.oncology_*\&quot;]\n        STG2[\&quot;staging.stg_aria_rt_referral\&quot;]\n        STG3[\&quot;staging.aria_booking\&quot;]\n        STG4[\&quot;staging.aria_ecad\&quot;]\n        STG5[\&quot;staging.stg_aria_ct\&quot;]\n        STG6[\&quot;staging.stg_aria_treat\&quot;]\n        STG7[\&quot;staging.aria_machine_appointments\&quot;]\n    end\n\n    LOAD1 --&gt; STG1\n    LOAD2 --&gt; STG2\n    LOAD3 --&gt; STG3\n    LOAD4 --&gt; STG4\n    LOAD5 --&gt; STG5\n    LOAD6 --&gt; STG6\n    LOAD7 --&gt; STG7\n\n    %% ==================================================\n    %% INTERMEDIATE LAYER\n    %% ==================================================\n\n    subgraph Intermediate[\&quot;Warehouse Intermediate Views\&quot;]\n\n        ONCREF[\&quot;int_oncology_referrals\&quot;]\n        ONCCLIN[\&quot;int_oncology_clinic_events\&quot;]\n        ONCEVT[\&quot;int_oncology_events\&quot;]\n\n        RTREF[\&quot;int_rt_referral\&quot;]\n        RTBOOK[\&quot;int_rt_booking_events\&quot;]\n        RTECAD[\&quot;int_rt_ecad_events\&quot;]\n        RTCT[\&quot;int_rt_ct_events\&quot;]\n        RTTREAT[\&quot;int_rt_treat_events\&quot;]\n        RTSUM[\&quot;int_rt_treat_summary\&quot;]\n\n        MACHAPPT[\&quot;int_rt_machine_appointments\&quot;]\n        MACHCAP[\&quot;int_rt_machine_capacity_window\&quot;]\n\n    end\n\n    STG1 --&gt; ONCREF\n    STG1 --&gt; ONCCLIN\n    ONCREF --&gt; ONCEVT\n\n    STG2 --&gt; RTREF\n    STG3 --&gt; RTBOOK\n    STG4 --&gt; RTECAD\n    STG5 --&gt; RTCT\n    STG6 --&gt; RTTREAT\n    RTTREAT --&gt; RTSUM\n\n    STG7 --&gt; MACHAPPT\n    MACHAPPT --&gt; MACHCAP\n\n    %% ==================================================\n    %% REFERENCE DATA\n    %% ==================================================\n\n    subgraph Reference[\&quot;Reference Dimensions\&quot;]\n\n        DIMCAT[\&quot;dim_rcr_category\&quot;]\n        DIMTARGET[\&quot;dim_rcr_targets\&quot;]\n\n    end\n\n    RTBOOK --&gt; DIMCAT\n    DIMCAT --&gt; DIMTARGET\n\n    %% ==================================================\n    %% FACT LAYER\n    %% ==================================================\n\n    subgraph Facts[\&quot;Warehouse Fact Layer\&quot;]\n\n        FACTONC[\&quot;fact_oncology_pathway\&quot;]\n\n        FACTRT[\&quot;fact_rt_pathway\&quot;]\n\n        FACTFULL[\&quot;fact_full_pathway\&quot;]\n\n        FACTDEMAND[\&quot;fact_predicted_rt_demand\&quot;]\n\n        FACTCAP[\&quot;fact_rt_machine_capacity\&quot;]\n\n    end\n\n    ONCEVT --&gt; FACTONC\n\n    RTREF --&gt; FACTRT\n    RTBOOK --&gt; FACTRT\n    RTECAD --&gt; FACTRT\n    RTCT --&gt; FACTRT\n    RTSUM --&gt; FACTRT\n    FACTONC --&gt; FACTRT\n    DIMTARGET --&gt; FACTRT\n\n    FACTRT --&gt; FACTFULL\n\n    FACTONC --&gt; FACTDEMAND\n\n    MACHCAP --&gt; FACTCAP\n    MACHAPPT --&gt; FACTCAP&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ame7qDuHPoqnhy8dKzFZ-47">
