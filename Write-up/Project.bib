@article{guercini2020,
  title = {E-Commerce Internationalization for Top Luxury Fashion Brands: Some Emerging Strategic Issues},
  shorttitle = {E-Commerce Internationalization for Top Luxury Fashion Brands},
  author = {Guercini, Simone and Ranfagni, Silvia and Runfola, Andrea},
  year = 2020,
